# ChatGuard — configuração do deploy (copie para .env e ajuste)
# cp .env.example .env

# Imagem publicada pelo build.sh do repositório do app.
# Para travar numa versão: wallesonnn/chatguard-app:v0.1.0
APP_IMAGE=wallesonnn/chatguard-app:latest

# Domínio público da aplicação
DOMAIN=chatguard.life

# Rede externa do Traefik que já roda na VPS (nome da rede Docker)
TRAEFIK_NETWORK=traefik-public

# Entrypoint e resolutor de certificado usados pelo Traefik da VPS
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=le

# Banco de dados local da stack (use uma senha forte)
POSTGRES_USER=chatguard
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=chatguard
POSTGRES_PORT=5432