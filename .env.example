# ChatGuard — configuração da stack Docker
# Copie para .env e ajuste: cp .env.example .env

# Domínio público da aplicação
DOMAIN=chatguard.life

# Rede externa do Traefik que já roda na VPS (nome da rede Docker)
TRAEFIK_NETWORK=traefik-public

# Entrypoint e resolutor de certificado usados pelo Traefik da VPS
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=le

# Banco de dados local da stack (use uma senha forte)
POSTGRES_USER=chatguard
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=chatguard
POSTGRES_PORT=5432